# NameClear environment variables
# Copy to `.env` locally and to Cloudflare Pages production/preview settings.

# --- Public (safe in the client bundle) ---
# Vite exposes these to the browser. The Stripe publishable key is public by design.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# Optional: canonical site URL override (defaults to https://nameclear.pages.dev)
# Used by sitemap generation (PUBLIC_SITE_URL) and SEO meta.
VITE_SITE_URL=https://nameclear.pages.dev

# --- Server-side secrets (NEVER expose these to the client) ---
# All of these are read by the Cloudflare Pages Functions backend. In local dev,
# `.dev.vars` is read by `wrangler pages dev`; in production, set them in the
# Pages project's environment variables. Client code must never import them.

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PRICE_ID=price_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Supabase (cache + paid reports + PDF storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# Email delivery for paid reports
RESEND_API_KEY=re_xxxx
RESEND_FROM=NameClear <reports@nameclear.pages.dev>

# Optional: USPTO TMSearch AWS WAF token (browser `aws-waf-token` cookie value).
# Only needed if USPTO starts blocking datacenter IPs.
TMSEARCH_WAF_TOKEN=

# Deployment
PUBLIC_SITE_URL=https://nameclear.pages.dev
